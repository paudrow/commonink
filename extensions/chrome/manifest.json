{
  "manifest_version": 3,
  "name": "Common Ink Capture",
  "description": "Save the page you're on, or a selection from it, to your Common Ink notes.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Save to Common Ink", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["https://commonink.app/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+I" }, "description": "Open Common Ink Capture" }
  }
}
