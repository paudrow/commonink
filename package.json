{
  "name": "commonink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first markdown notes that any agent can use (prototype)",
  "bin": {
    "commonink": "bin/commonink",
    "quire": "bin/quire"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/server/main.ts",
    "mcp": "bin/commonink mcp",
    "import-samples": "node --disable-warning=ExperimentalWarning --import tsx scripts/import-samples.ts",
    "agent-demo": "node --disable-warning=ExperimentalWarning --import tsx scripts/agent-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"test/**/*.test.ts\"",
    "test:journeys": "node --disable-warning=ExperimentalWarning --import tsx --test --test-reporter=spec \"test/journeys/*.test.ts\"",
    "check": "npm run typecheck && npm run cloud:typecheck && tsc -p bench && npm test",
    "build:web": "vite build web --outDir ../dist --emptyOutDir",
    "build:cli": "vite build --config cli/vite.config.ts",
    "cloud:dev": "npm run build:web && wrangler d1 migrations apply commonink --local -c cloud/wrangler.jsonc && wrangler dev -c cloud/wrangler.jsonc --port 8787 --local-upstream localhost:8787",
    "cloud:preview": "npm run build:web && wrangler d1 migrations apply commonink-preview --remote -c cloud/wrangler.preview-migrations.jsonc && wrangler preview -c cloud/wrangler.jsonc",
    "cloud:deploy": "npm run build:web && wrangler d1 migrations apply commonink --remote -c cloud/wrangler.jsonc && wrangler deploy -c cloud/wrangler.jsonc",
    "cloud:typecheck": "tsc -p cloud",
    "brand": "tsx scripts/brand.ts",
    "docs": "tsx scripts/docs.ts",
    "bench": "node --disable-warning=ExperimentalWarning --import tsx bench/core.ts",
    "bench:changelog": "node --disable-warning=ExperimentalWarning --import tsx bench/changelog.ts",
    "bench:cloud": "node --disable-warning=ExperimentalWarning --import tsx bench/cloud.ts",
    "bench:bundle": "tsx bench/bundle.ts",
    "bench:web": "node --disable-warning=ExperimentalWarning --import tsx bench/web.ts",
    "check:motion": "node --disable-warning=ExperimentalWarning --import tsx scripts/check-motion.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@replit/codemirror-vim": "^6.4.0",
    "diff": "^9.0.0",
    "docx": "^9.8.1",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.1",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "mermaid": "^12.1.0",
    "node-diff3": "^3.2.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@lezer/javascript": "^1.5.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "undici": "7.30.0"
  }
}
