{
  "name": "quire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first markdown notes that any agent can use (prototype)",
  "bin": {
    "quire": "bin/quire"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/server/main.ts",
    "mcp": "bin/quire mcp",
    "agent-demo": "node --disable-warning=ExperimentalWarning --import tsx scripts/agent-demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@replit/codemirror-vim": "^6.4.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "node-diff3": "^3.2.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
